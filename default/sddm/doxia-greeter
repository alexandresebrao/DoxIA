#!/bin/bash

# The compositor SDDM runs its Wayland greeter on (etc/sddm.conf.d/10-wayland.conf).
# Same environment fixes as bin/omarchy-mango-session, which the greeter can't
# use: it runs as the sddm user, without uwsm or an Omarchy checkout.

config=/usr/share/sddm/mango.conf

# No render node (Hyper-V's hyperv_drm, plain KMS framebuffers): render with
# llvmpipe on the primary node instead of refusing to start.
if ! compgen -G "/dev/dri/renderD*" >/dev/null; then
  export WLR_RENDERER_ALLOW_SOFTWARE=1
fi

if [[ $(systemd-detect-virt 2>/dev/null) == "microsoft" ]]; then
  # hyperv_drm has no cursor plane, so the hardware cursor is invisible.
  export WLR_NO_HARDWARE_CURSORS=1
  # Partial redraws leave stale squares flickering on hyperv_drm's dumb buffers.
  export WLR_SCENE_DEBUG_DAMAGE=rerender
  export WLR_SCENE_DISABLE_DIRECT_SCANOUT=1
  config=/usr/share/sddm/mango-hyperv.conf
fi

exec mango -c "$config" "$@"
