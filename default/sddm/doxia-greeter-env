#!/bin/bash

# Runs before SDDM starts (sddm.service ExecStartPre, see
# default/sddm/sddm.service.d/10-doxia.conf) and writes the greeter settings
# that only some machines need. Checked on every boot, so a disk moved to
# another hypervisor or to real hardware drops what no longer applies.

conf=/etc/sddm.conf.d/20-doxia-vm.conf

if [[ $(systemd-detect-virt 2>/dev/null) == "vmware" ]]; then
  # On vmwgfx, wlroots rejects the greeter's GL dmabufs ("Failed to close
  # buffer handle"), Qt dies with a protocol error and the login screen stays
  # black with only the cursor. Software Qt Quick hands mango shm buffers.
  printf '[General]\nGreeterEnvironment=QT_QUICK_BACKEND=software\n' > "$conf"
else
  rm -f "$conf"
fi
