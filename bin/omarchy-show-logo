#!/bin/bash

# omarchy:summary=Display the DoxIA wordmark in the terminal (light gray DOX, red IA).

# The colored wordmark is pre-rendered with 24-bit colors so it never depends on
# the terminal palette (the old version painted logo.txt with ANSI green, \e[32m).
LOGO_ANSI="$HOME/.config/omarchy/branding/logo.ansi"

clear
echo
# Fedora port: the brand as an image in terminals that draw images (see
# fedora/doxia/term-graphics), the ANSI wordmark elsewhere.
if "$OMARCHY_PATH/fedora/doxia/show-brand"; then
  :
elif [[ -r $LOGO_ANSI ]]; then
  cat <"$LOGO_ANSI"
else
  printf '\033[1;38;2;240;240;240m'
  cat <$OMARCHY_PATH/logo.txt
  printf '\033[0m'
fi
echo
echo
