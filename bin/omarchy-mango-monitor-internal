#!/bin/bash

# omarchy:summary=Enable, disable, toggle, or recover the internal laptop display
# omarchy:args=<on|off|toggle|recover>

FLAG="$HOME/.local/state/omarchy/toggles/mango/internal-monitor-disable"
INTERNAL=$(omarchy-mango-monitor-laptop)

on() {
  if [[ -f $FLAG ]]; then
    rm -f "$FLAG"
    omarchy-mango-monitor-apply
    omarchy-notification-send -g 󰍹 "Tela do notebook ativada"
  fi
}

off() {
  if [[ -z $INTERNAL ]]; then
    omarchy-notification-send -g 󰍹 "Nenhuma tela de notebook encontrada"
    exit 1
  fi

  if ! omarchy-mango-monitor-external-active; then
    omarchy-notification-send -g 󰍹 "Não é possível desativar a única tela ativa"
    exit 1
  fi

  if [[ ! -f $FLAG ]]; then
    omarchy-mango-monitor-internal-mirror off >/dev/null
    mkdir -p "$(dirname "$FLAG")"
    touch "$FLAG"
    omarchy-mango-monitor-apply
    omarchy-notification-send -g 󰍹 "Tela do notebook desativada"
  fi
}

# Runs from the monitor watcher: only acts when the external monitor went away
# while the laptop display was off by hand.
recover() {
  omarchy-mango-monitor-external-active && return 0
  [[ -f $FLAG ]] || return 0

  rm -f "$FLAG"
  omarchy-mango-monitor-apply
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) if [[ -f $FLAG ]]; then on; else off; fi ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
