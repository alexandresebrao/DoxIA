#!/bin/bash

# omarchy:summary=Check whether Omarchy updates are available.
# Fedora port: omarchy-update-check reads dnf, Flatpak and the DoxIA checkout;
# this keeps the old one-line-per-update output and exit status.

set -euo pipefail

if ! status=$(omarchy-update-check "$@"); then
  echo "DoxIA is up to date"
  exit 1
fi

jq -r '
  (if .staged.pending then "Update downloaded, waiting for the reboot" else empty end),
  (if (.system | length) > 0 then "\(.system | length) system package(s)" else empty end),
  (if (.flatpak.apps | length) > 0 then "\(.flatpak.apps | length) Flatpak app(s)" else empty end),
  (if .flatpak.runtimes > 0 then "\(.flatpak.runtimes) Flatpak runtime(s)" else empty end),
  (if .doxia.behind > 0 then "omarchy-dev-checkout \(.doxia.behind) new \(if .doxia.behind == 1 then "commit" else "commits" end) on \(.doxia.upstream)" else empty end)
' <<<"$status"
