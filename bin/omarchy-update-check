#!/usr/bin/python3

# omarchy:summary=List what an update would change: dnf packages, Flatpak apps and DoxIA commits
# omarchy:args=[--refresh] [--cached]
# omarchy:examples=omarchy update check | omarchy update check --refresh

"""Prints a JSON summary and keeps a copy in ~/.cache/omarchy/update-status.json
for the update window and the bar icon. Exits 0 when there is something to do
(including an update downloaded and waiting for the reboot), 1 otherwise.

  --refresh  make dnf download fresh repository metadata first
  --cached   print the last summary without checking again
"""

import json
import os
import re
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

CACHE = Path.home() / ".cache/omarchy/update-status.json"
STAGED = Path("/var/lib/doxia/update-staged.json")
FINISH_PENDING = Path("/var/lib/doxia/update-finish-pending")
OMARCHY_PATH = os.environ.get("OMARCHY_PATH", "")
PKG_LINE = re.compile(r"^(\S+)\.(\w+)\s+(\S+)\s+(\S+)\s*$")


def run(cmd, timeout=180):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except (OSError, subprocess.TimeoutExpired):
        return -1, ""


def system_updates(refresh, errors):
    # -y: run without root, dnf keeps its own cache and asks again to import the
    # key of a signed repository (DoxIA's, from the checkout); without a terminal
    # the answer is no and the repository is left out, here and in upgradable().
    cmd = ["dnf", "-q", "-y", "check-update"] + (["--refresh"] if refresh else [])
    code, out = run(cmd)
    if code not in (0, 100):
        errors.append("Não foi possível consultar os repositórios do dnf.")
        return []
    pkgs, section = [], "Upgrades"
    for line in out.splitlines():
        if line and not line[0].isspace() and " " not in line.strip():
            section = line.strip()
            continue
        m = PKG_LINE.match(line)
        if m and section == "Upgrades":
            pkgs.append({"name": m[1], "arch": m[2], "to": m[3], "repo": m[4], "from": ""})
    if pkgs:
        code, out = run(["rpm", "-q", "--qf", "%{NAME}.%{ARCH} %{VERSION}-%{RELEASE}\n"] +
                        [f"{p['name']}.{p['arch']}" for p in pkgs], timeout=30)
        installed = dict(line.split(" ", 1) for line in out.splitlines() if " " in line)
        for p in pkgs:
            p["from"] = installed.get(f"{p['name']}.{p['arch']}", "")
    return pkgs


def upgradable(pkgs):
    """The name.arch pairs a real `dnf upgrade` would take, or None when the
    dry run gives no answer. check-update also lists updates the solver has
    to skip (a pinned dependency, as libheif-freeworld from RPM Fusion holds
    libheif at its own version until it is rebuilt), which no update would
    install."""
    env = dict(os.environ, LC_ALL="C")
    try:
        p = subprocess.run(["dnf", "upgrade", "--assumeno"], capture_output=True, text=True,
                           timeout=180, env=env)
    except (OSError, subprocess.TimeoutExpired):
        return None
    out = p.stdout + p.stderr
    if "Nothing to do." in out:
        return set()
    if "Transaction Summary:" not in out:
        return None
    taken, section = set(), ""
    for line in out.splitlines():
        if line and not line[0].isspace():
            section = line.strip()
            continue
        if section == "Upgrading:" and line.startswith(" ") and not line.startswith("  "):
            fields = line.split()
            if len(fields) >= 2:
                taken.add(f"{fields[0]}.{fields[1]}")
    return taken


def split_held(pkgs):
    taken = upgradable(pkgs) if pkgs else None
    if taken is None:
        return pkgs, []
    keep = [p for p in pkgs if f"{p['name']}.{p['arch']}" in taken]
    held = [p for p in pkgs if f"{p['name']}.{p['arch']}" not in taken]
    return keep, held


def flatpak_updates(errors):
    apps, runtimes = [], 0
    code, out = run(["flatpak", "remote-ls", "--updates", "--columns=ref,name"])
    if code != 0:
        if code != -1 or Path("/usr/bin/flatpak").exists():
            errors.append("Não foi possível consultar o Flathub.")
        return {"apps": apps, "runtimes": runtimes}
    for line in out.splitlines():
        ref, _, name = line.partition("\t")
        if ref.startswith("app/"):
            apps.append({"id": ref.split("/")[1], "name": name.strip() or ref.split("/")[1]})
        elif ref.startswith("runtime/"):
            runtimes += 1
    return {"apps": apps, "runtimes": runtimes}


def doxia_updates():
    info = {"behind": 0, "upstream": "", "head": "", "commits": []}
    if not OMARCHY_PATH or OMARCHY_PATH == "/usr/share/omarchy":
        return info
    git = ["git", "-C", OMARCHY_PATH]
    _, upstream = run(git + ["rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}"], 10)
    _, head = run(git + ["rev-parse", "--short", "HEAD"], 10)
    info["upstream"], info["head"] = upstream.strip(), head.strip()
    if not info["upstream"]:
        return info
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    try:
        subprocess.run(git + ["fetch", "--quiet"], env=env, timeout=20, capture_output=True)
    except (OSError, subprocess.TimeoutExpired):
        pass
    _, log = run(git + ["log", "--format=%s", f"HEAD..{info['upstream']}"], 10)
    info["commits"] = [line for line in log.splitlines() if line]
    info["behind"] = len(info["commits"])
    return info


def staged():
    pending = os.path.islink("/system-update") or FINISH_PENDING.exists()
    data = {"pending": pending, "packages": [], "stagedAt": 0, "finishing": FINISH_PENDING.exists()}
    if pending:
        try:
            saved = json.loads(STAGED.read_text())
            data["packages"] = saved.get("packages", [])
            data["stagedAt"] = saved.get("stagedAt", 0)
            # Set when the stored transaction moves to a new Fedora release.
            data["release"] = saved.get("release", 0)
        except (OSError, ValueError):
            pass
    return data


FEDORA_RELEASES = "https://dl.fedoraproject.org/pub/fedora/linux/releases"
DOXIA_REPO = Path("/etc/yum.repos.d/doxia.repo")
# The dry run downloads the next release's metadata: once a day is enough.
RELEASE_DRY_RUN_EVERY = 24 * 3600
PROBLEM_LINE = re.compile(r"^(?:Problem(?: \d+)?: |\s+- )installed package (\S+) requires (.+?), "
                          r"but none of the providers can be installed")
NEVRA = re.compile(r"^(.+)-[^-]+-[^-]+\.[^.]+$")


def url_ok(url):
    request = urllib.request.Request(url, method="HEAD", headers={"User-Agent": "DoxIA update check"})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return 200 <= response.status < 300
    except (OSError, ValueError):
        return False


def doxia_repo_url(release):
    """The DoxIA repository of a Fedora release, from doxia.repo ("" without it)."""
    try:
        match = re.search(r"^baseurl\s*=\s*(\S+)", DOXIA_REPO.read_text(), re.M)
    except OSError:
        return ""
    if not match:
        return ""
    return match[1].replace("$releasever", str(release)).replace("$basearch", os.uname().machine)


def release_blockers(release):
    """The installed packages that would stop the move to `release`, from a dry run
    (as the user: system-upgrade itself wants root). [] when it would go through,
    None when the dry run gives no answer."""
    env = dict(os.environ, LC_ALL="C")
    # dnf keeps a cache per repository URL and asks again for the key of the DoxIA
    # repository of the new release; it comes from the checkout, so say yes.
    try:
        subprocess.run(["dnf", "-q", "-y", f"--releasever={release}", "makecache", "--repo", "doxia"],
                       capture_output=True, text=True, timeout=300, env=env)
        p = subprocess.run(["dnf", f"--releasever={release}", "distro-sync", "--assumeno"],
                           capture_output=True, text=True, timeout=900, env=env)
    except (OSError, subprocess.TimeoutExpired):
        return None
    out = p.stdout + p.stderr
    if "Transaction Summary:" in out or "Nothing to do." in out:
        return []
    blockers = {}
    for line in out.splitlines():
        match = PROBLEM_LINE.match(line)
        if match:
            nevra = NEVRA.match(match[1])
            name = nevra[1] if nevra else match[1]
            blockers.setdefault(name, {"package": name, "installed": match[1], "requires": match[2]})
    return list(blockers.values()) or None


def release_info(previous, refresh, staged_pending):
    """The next Fedora release, offered once Fedora has released it and the DoxIA
    repository publishes it: the second is the DoxIA side's go-ahead (its RPMs for
    that release are built and uploaded, fedora/repo)."""
    code, out = run(["rpm", "-E", "%fedora"], timeout=10)
    try:
        current = int(out.strip())
    except ValueError:
        return {}
    upcoming = current + 1
    info = {"current": current, "next": upcoming, "fedora": False, "doxia": False,
            "offered": False, "blockers": [], "dryRun": "", "checkedAt": 0}
    arch = os.uname().machine
    info["fedora"] = url_ok(f"{FEDORA_RELEASES}/{upcoming}/Everything/{arch}/os/repodata/repomd.xml")
    if info["fedora"]:
        url = doxia_repo_url(upcoming)
        info["doxia"] = bool(url) and url_ok(url.rstrip("/") + "/repodata/repomd.xml")
    if not (info["fedora"] and info["doxia"]) or staged_pending:
        return info
    info["offered"] = True
    before = (previous or {}).get("release") or {}
    if (not refresh and before.get("next") == upcoming and before.get("dryRun")
            and time.time() - before.get("checkedAt", 0) < RELEASE_DRY_RUN_EVERY):
        for key in ("blockers", "dryRun", "checkedAt"):
            info[key] = before.get(key, info[key])
        return info
    blockers = release_blockers(upcoming)
    info["checkedAt"] = int(time.time())
    info["dryRun"] = "failed" if blockers is None else "ok"
    info["blockers"] = blockers or []
    return info


def snapper_present():
    return any(Path(d, "snapper").exists() for d in os.environ.get("PATH", "/usr/bin").split(":"))


def main(args):
    if "--cached" in args:
        try:
            status = json.loads(CACHE.read_text())
        except (OSError, ValueError):
            sys.exit(1)
    else:
        errors = []
        try:
            previous = json.loads(CACHE.read_text())
        except (OSError, ValueError):
            previous = None
        stage = staged()
        # A stored offline transaction already holds the system updates.
        system, held = ([], []) if stage["pending"] else split_held(system_updates("--refresh" in args, errors))
        status = {
            "checkedAt": int(time.time()),
            "system": system,
            # Listed by dnf but skipped by its solver: not counted as pending.
            "held": held,
            "flatpak": flatpak_updates(errors),
            "doxia": doxia_updates(),
            "staged": stage,
            "release": release_info(previous, "--refresh" in args, stage["pending"]),
            "snapper": snapper_present(),
            "errors": errors,
        }
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        tmp = CACHE.with_name(CACHE.name + ".tmp")
        tmp.write_text(json.dumps(status))
        tmp.replace(CACHE)

    print(json.dumps(status))
    pending = (status["system"] or status["flatpak"]["apps"] or status["flatpak"]["runtimes"]
               or status["doxia"]["behind"] or status["staged"]["pending"]
               or (status.get("release") or {}).get("offered"))
    sys.exit(0 if pending else 1)


main(sys.argv[1:])
