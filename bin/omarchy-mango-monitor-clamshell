#!/bin/bash

# omarchy:summary=Apply clamshell display state to mango monitors
# omarchy:hidden=true

# Lid shut with an external monitor on: the laptop display goes off. Anything
# else brings it back (unless it was turned off by hand).

FLAG="$HOME/.local/state/omarchy/toggles/mango/internal-monitor-clamshell"

omarchy-mango-monitor-internal recover >/dev/null 2>&1 || true
omarchy-mango-monitor-internal-mirror recover >/dev/null 2>&1 || true

[[ -n $(omarchy-mango-monitor-laptop) ]] || exit 0

if omarchy-hw-clamshell && omarchy-mango-monitor-external-active; then
  [[ -f $FLAG ]] && exit 0
  mkdir -p "$(dirname "$FLAG")"
  touch "$FLAG"
else
  [[ -f $FLAG ]] || exit 0
  rm -f "$FLAG"
fi

omarchy-mango-monitor-apply
