#!/bin/bash

# omarchy:summary=Launch an app or focus an existing window matching a pattern
# omarchy:args=<window-pattern> <launch-command>

if (($# == 0)); then
  echo "Usage: omarchy-launch-or-focus [window-pattern] [launch-command]"
  exit 1
fi

WINDOW_PATTERN="$1"
LAUNCH_COMMAND="${2:-"uwsm-app -- $WINDOW_PATTERN"}"
WINDOW_ID=$(mmsg get all-clients | jq -r --arg p "$WINDOW_PATTERN" '.clients[]|select((.appid|test("\\b" + $p + "\\b";"i")) or (.title|test("\\b" + $p + "\\b";"i")))|.id' | head -n1)

if [[ -n $WINDOW_ID ]]; then
  mmsg dispatch focusid "client,$WINDOW_ID" >/dev/null
  exit 0
fi

# A window takes a moment to map: a second call meanwhile (a double click)
# would launch it again. One launch per pattern every 3 s.
stamp="${XDG_RUNTIME_DIR:-/tmp}/omarchy-launch-or-focus-${WINDOW_PATTERN//[^[:alnum:]._-]/_}"
exec 9>"$stamp.lock"
flock -n 9 || exit 0
if [[ -f $stamp ]] && (($(date +%s) - $(stat -c %Y "$stamp") < 3)); then
  exit 0
fi
touch "$stamp"
exec 9>&-
eval exec setsid $LAUNCH_COMMAND
