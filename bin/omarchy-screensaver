#!/bin/bash

# omarchy:summary=Run the Omarchy screensaver using random effects from TTE.

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit 0
}

# Exit the screensaver on signals and input from keyboard and mouse
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # Set background color to black

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

tty=$(tty 2>/dev/null)

# Terminals allocate the pty at the default 80x24 and only resize it once the
# compositor has told the window how big it is. ttfx measures the terminal once,
# at startup, so starting it before the resize lands sizes an 80x24 canvas and
# paints it into the corner of a fullscreen window.
wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

# FedorAI palette: every effect settles on silver (FEDOR) fading into Xi blue
# (AI) instead of its own default colors. Effects that animate in strong green
# (matrix, binarypath, decrypt, vhstape, errorcorrect, swarm, colorshift) are left out;
# synthgrid has no final gradient to recolor.
effects=($(ttfx --help | awk '/^Commands:/{f=1;next} /^Options:/{f=0} f && $1!="help" {print $1}' | grep -vxE 'matrix|binarypath|decrypt|vhstape|errorcorrect|swarm|colorshift|synthgrid'))

# The final gradient spans the whole canvas, not the text, so build one stop per
# terminal column: silver across FEDOR, blue across AI (which starts at column
# 68 of the 94-column wordmark).
wordmark=~/.config/omarchy/branding/screensaver.txt
cols=$(stty size 2>/dev/null | cut -d' ' -f2)
stops=($(awk -v cols="${cols:-120}" -v os_col=68 '
  { if (length($0) > w) w = length($0) }
  function mix(a, b, t,   i, out) {
    out = ""
    for (i = 0; i < 3; i++)
      out = out sprintf("%02x", a[i] + (b[i] - a[i]) * t)
    return out
  }
  END {
    s1[0]=0xf0; s1[1]=0xf0; s1[2]=0xf0; s2[0]=0xf0; s2[1]=0xf0; s2[2]=0xf0
    b1[0]=0xee; b1[1]=0x00; b1[2]=0x00; b2[0]=0xee; b2[1]=0x00; b2[2]=0x00
    off = int((cols - w) / 2)
    for (c = 0; c < cols; c++) {
      x = c - off
      if (x < os_col) { t = x / os_col; if (t < 0) t = 0; print mix(s1, s2, t) }
      else { t = (x - os_col) / (w - os_col); if (t > 1) t = 1; print mix(b1, b2, t) }
    }
  }' "$wordmark"))
((${#stops[@]})) || stops=(f0f0f0 ee0000)

while true; do
  effect=${effects[RANDOM % ${#effects[@]}]}
  ttfx -i "$wordmark" \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
    --no-eol --no-restore-cursor \
    "$effect" --final-gradient-stops "${stops[@]}" --final-gradient-steps 1 --final-gradient-direction horizontal &

  while pgrep -t "${tty#/dev/}" -x ttfx >/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
done
