#!/bin/bash

# omarchy:summary=Toggle suspend availability in the system menu

omarchy-toggle suspend-off

if omarchy-toggle-enabled suspend-off; then
  omarchy-notification-send -g 󰒲 "Suspender removido do menu do sistema"
else
  omarchy-notification-send -g 󰒲 "Suspender agora disponível no menu do sistema"
fi
