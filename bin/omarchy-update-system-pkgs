#!/bin/bash

# omarchy:summary=Update system packages with dnf
# omarchy:args=[--offline | --release <fedora>]
# omarchy:requires-sudo=true
# Fedora port: dnf instead of pacman.
# --offline downloads and tests the upgrade, which then installs on a reboot
# (omarchy-update-offline arms it). --release <N> does the same for the move to
# Fedora N (dnf system-upgrade download, the same offline transaction).
# From the update window (OMARCHY_UPDATE_GUI)
# dnf's "[ 12/380]" lines move the step's progress bar.

set -e

# dnf fetches 3 packages at a time by default, so one slow mirror holds up the rest.
dnf_args=(upgrade --refresh -y --setopt=max_parallel_downloads=10)
# Stored for the reboot (--offline, --release): only downloads and the test run.
staged=0
case ${1:-} in
  --offline)
    dnf_args+=(--offline)
    staged=1
    ;;
  --release)
    release=${2:?usage: omarchy-update-system-pkgs --release <fedora>}
    [[ $release =~ ^[0-9]+$ ]] || { echo "Not a Fedora release: $release" >&2; exit 1; }
    # The same offline transaction as --offline: omarchy-update-offline arms it.
    dnf_args=(system-upgrade download --releasever="$release" -y --setopt=max_parallel_downloads=10)
    staged=1
    ;;
esac

if [[ -n ${OMARCHY_UPDATE_GUI:-} ]]; then
  step=system
  (( staged )) && step=download
  echo -e "\e[32m\nUpdate system packages\e[0m"
  sudo dnf "${dnf_args[@]}" 2>&1 | {
    # Downloads fill the first half and the transaction the second; an offline
    # run stops after the downloads and its test transaction.
    phase_start=0 phase_size=0.5 last=-1
    (( staged )) && phase_size=1
    while IFS= read -r line; do
      echo "$line"
      [[ $line == "Running transaction"* ]] && phase_start=0.5
      if [[ $line =~ ^\[\ *([0-9]+)/([0-9]+)\]\ +(.*) ]]; then
        pct=$(( 100 * BASH_REMATCH[1] / BASH_REMATCH[2] ))
        if (( pct != last )); then
          last=$pct
          item=${BASH_REMATCH[3]%% *}
          omarchy-update-state frac "$step" "$(awk -v s="$phase_start" -v z="$phase_size" -v p="$pct" 'BEGIN { print s + z * p / 100 }')" \
            "${BASH_REMATCH[1]}/${BASH_REMATCH[2]} · $item"
        fi
      fi
    done
  }
  exit "${PIPESTATUS[0]}"
fi

echo -e "\e[32m\nUpdate system packages\e[0m"
sudo dnf "${dnf_args[@]}"
