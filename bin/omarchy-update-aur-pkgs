#!/bin/bash

# omarchy:summary=Update Flatpak apps if any are installed
# Fedora port: Flathub takes the place of the AUR, so its apps update here.

if omarchy-cmd-present flatpak && [[ -n $(flatpak list --columns=application 2>/dev/null) ]]; then
  echo -e "\e[32m\nUpdate Flatpak apps\e[0m"
  sudo flatpak update -y --noninteractive
  flatpak update --user -y --noninteractive 2>/dev/null || true
  echo
fi
