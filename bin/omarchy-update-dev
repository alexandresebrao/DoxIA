#!/bin/bash

# omarchy:summary=Update the active Omarchy dev checkout

set -euo pipefail

[[ $OMARCHY_PATH != "/usr/share/omarchy" ]] || exit 0

if ! git -C "$OMARCHY_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: OMARCHY_PATH is not a git checkout: $OMARCHY_PATH" >&2
  exit 1
fi

upstream=$(git -C "$OMARCHY_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Omarchy dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Omarchy dev checkout\e[0m"
# --autostash keeps uncommitted local edits across the update. When they clash with
# upstream, git still exits 0 but leaves conflict markers, which the update scripts
# would then run: put the upstream version of those files back, and leave the local
# edits in the stash.
git -C "$OMARCHY_PATH" fetch --quiet
if git -C "$OMARCHY_PATH" merge-base --is-ancestor HEAD '@{upstream}'; then
  git -C "$OMARCHY_PATH" merge --ff-only --autostash '@{upstream}'
else
  # Local commits not upstream yet: replay them on top. Only a real conflict
  # stops the update, and then the checkout is put back as it was.
  echo "Rebasing local commits onto $upstream"
  if ! git -C "$OMARCHY_PATH" rebase --autostash '@{upstream}'; then
    git -C "$OMARCHY_PATH" rebase --abort || true
    echo -e "\e[31mLocal commits conflict with $upstream; resolve by hand with git rebase $upstream\e[0m" >&2
    exit 1
  fi
fi
conflicted=$(git -C "$OMARCHY_PATH" diff --name-only --diff-filter=U)
if [[ -n $conflicted ]]; then
  mapfile -t files <<<"$conflicted"
  git -C "$OMARCHY_PATH" checkout HEAD -- "${files[@]}"
  git -C "$OMARCHY_PATH" reset -q
  echo -e "\e[33mLocal changes to these files clashed with the update and were set aside in $(git -C "$OMARCHY_PATH" rev-parse --short stash@{0}) (git stash list):\e[0m"
  printf '  %s\n' "${files[@]}"
fi
