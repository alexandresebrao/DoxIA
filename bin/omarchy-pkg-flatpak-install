#!/bin/bash

# omarchy:summary=Show a fuzzy-finder TUI for picking new Flathub apps to install.
# omarchy:requires-sudo=true
# Fedora port: Flathub takes the place of the AUR for software outside the distro repos.

fzf_args=(
  --multi
  --delimiter '\t'
  --with-nth '2,1'
  --preview 'flatpak remote-info flathub {1}'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

flatpak remotes --columns=name | grep -qx flathub ||
  sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

installed=$(flatpak list --app --columns=application)
app_ids=$(flatpak remote-ls --app --columns=application,name flathub |
  awk -F'\t' -v inst="$installed" 'BEGIN { n = split(inst, a, "\n"); for (i = 1; i <= n; i++) have[a[i]] = 1 } !($1 in have)' |
  sort -t$'\t' -k2,2f | fzf "${fzf_args[@]}" | cut -f1)

if [[ -n $app_ids ]]; then
  source omarchy-sudo-keepalive

  echo "$app_ids" | tr '\n' ' ' | xargs sudo flatpak install -y --noninteractive flathub
  omarchy-show-done
fi
