#!/bin/bash

# omarchy:summary=Restart the DoxIA shell
# omarchy:examples=omarchy restart shell

# doxia-shell relocks a session it finds stranded, but a live lock screen dies
# with it: refuse then.
if [[ $(omarchy-shell lock status 2>/dev/null | jq -r '.secure or .requested' 2>/dev/null) == "true" ]]; then
  echo "Refusing to restart the shell while the session is locked." >&2
  exit 1
fi
systemctl --user restart doxia-shell.service || exit 1
for (( attempt = 0; attempt < 50; attempt++ )); do
  if [[ $(omarchy-shell shell ping 2>/dev/null) == "ok" ]]; then
    systemctl --user try-restart 'omarchy-*-invitation.service' 2>/dev/null || true
    exit 0
  fi
  sleep 0.1
done
echo "doxia-shell did not become ready after restart." >&2
exit 1
