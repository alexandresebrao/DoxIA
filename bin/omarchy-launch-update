#!/bin/bash

# omarchy:summary=Open the Atualizar DoxIA window
# omarchy:args=[--prefs]

# The window is its own app (fedora/doxia/rs/atualizar, installed by
# fedora/doxia/install-rs), so the update can reload and restart the
# shell under it. A second launch raises the open window. Without the app,
# the omarchy.update shell panel; without a running shell, the update in a
# terminal.
if omarchy-cmd-present doxia-atualizar; then
  exec setsid uwsm-app -- doxia-atualizar "$@"
fi

payload='{}'
[[ ${1:-} == "--prefs" ]] && payload='{"tab": "prefs"}'
if [[ $(omarchy-shell shell summon omarchy.update "$payload" 2>/dev/null) != *ok* ]]; then
  exec omarchy-launch-floating-terminal-with-presentation omarchy-update
fi
