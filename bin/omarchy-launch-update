#!/bin/bash

# omarchy:summary=Open the Atualizar DoxIA window

# The window is the omarchy.update shell plugin. Without a running shell, fall
# back to the update in a terminal.
if [[ $(omarchy-shell shell summon omarchy.update '{}' 2>/dev/null) != *ok* ]]; then
  exec omarchy-launch-floating-terminal-with-presentation omarchy-update
fi
