## lorax template file: DoxIA theme for the installer runtime (build.sh passes
## themedir=fedora/iso/anaconda). Runs after runtime-install.tmpl has installed
## anaconda, so the profile directory exists.
<%page args="root, themedir"/>

mkdir usr/share/anaconda/pixmaps/doxia
runcmd cp ${themedir}/doxia.css ${themedir}/sidebar-bg.png ${themedir}/sidebar-logo.png ${themedir}/topbar-bg.png ${root}/usr/share/anaconda/pixmaps/doxia/
runcmd cp ${themedir}/doxia.conf ${root}/etc/anaconda/profile.d/doxia.conf
