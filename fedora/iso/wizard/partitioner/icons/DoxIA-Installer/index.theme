[Icon Theme]
Name=DoxIA Installer
Comment=Disk icons for the installer's partitioners, drawn like the DoxIA logo; the rest comes from Adwaita
Inherits=Adwaita,hicolor
Directories=scalable/devices,scalable/places

[scalable/devices]
Size=64
MinSize=16
MaxSize=256
Type=Scalable
Context=Devices

[scalable/places]
Size=64
MinSize=16
MaxSize=256
Type=Scalable
Context=Places
