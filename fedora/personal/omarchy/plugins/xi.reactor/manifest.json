{
  "schemaVersion": 1,
  "id": "xi.reactor",
  "name": "Xi Reactor HUD",
  "version": "1.0.0",
  "author": "klab",
  "license": "MIT",
  "description": "HUD de cockpit: saída do gerador (CPU) e carga (memória) em barras segmentadas.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Reactor.qml" },
  "barWidget": {
    "displayName": "Xi Reactor HUD",
    "description": "GEN = uso de CPU, MEM = uso de memória. Clique abre o btop.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "intervalSec": 2, "segments": 8 },
    "schema": [
      { "key": "intervalSec", "type": "integer", "label": "Intervalo (segundos)", "min": 1, "max": 30, "step": 1, "defaultValue": 2 },
      { "key": "segments", "type": "integer", "label": "Segmentos por barra", "min": 4, "max": 16, "step": 1, "defaultValue": 8 }
    ]
  }
}
