#!/bin/bash

# Prints "TYPE ROWS PATH", the fastfetch logo type, height and source that draw
# the DoxIA brand (default/sddm/omarchy/brand.png) for the given protocol
# (term-graphics), COLS cells wide (default 46, the width of the ASCII logo).
# Kitty graphics keep the transparency, so fastfetch draws brand.png itself
# (ROWS 0: it works the height out). Its Sixel paints the transparent parts
# black, so for Sixel chafa renders the escapes into a file, sized for the cell
# size of the terminal on /dev/tty and cached per width and cell size, and
# fastfetch prints it raw.

protocol=${1:?usage: brand-image kitty|sixel [COLS]}
cols=${2:-46}
omarchy_path=$(dirname "$(dirname "$(dirname "$(readlink -f "$0")")")")
brand=$omarchy_path/default/sddm/omarchy/brand.png

case $protocol in
  kitty) echo "kitty 0 $brand"; exit 0 ;;
  sixel) ;;
  *) exit 1 ;;
esac
command -v chafa >/dev/null || exit 1

# Pixel size of one cell, from the terminal's window size in pixels
read -r cell_w cell_h < <(python3 -c '
import fcntl, struct, termios
with open("/dev/tty") as tty:
    rows, cols, xpx, ypx = struct.unpack("HHHH", fcntl.ioctl(tty, termios.TIOCGWINSZ, b"\0" * 8))
if xpx and ypx and cols and rows:
    print(xpx // cols, ypx // rows)
' 2>/dev/null)
[[ -n ${cell_w:-} ]] || exit 1

out=${XDG_CACHE_HOME:-$HOME/.cache}/doxia/brand-sixel-$cols-${cell_w}x$cell_h
if [[ ! -s $out || $out -ot $brand ]]; then
  mkdir -p "$(dirname "$out")"
  # chafa draws pixel graphics at the image's own size with --scale 1, so hand
  # it the brand already as wide as the cells it should cover.
  magick "$brand" -resize "$((cols * cell_w))x" "$out.png" &&
    chafa --format sixels --scale 1 --polite on --animate off "$out.png" > "$out.tmp" 2>/dev/null &&
    mv "$out.tmp" "$out" || { rm -f "$out.png" "$out.tmp"; exit 1; }
  rm -f "$out.png"
fi
# The Sixel raster attributes ("Pan;Pad;width;height) carry the drawn height
height=$(grep -ao '"1;1;[0-9]*;[0-9]*' "$out" | head -1 | cut -d';' -f4)
[[ -n $height ]] || exit 1
echo "file-raw $(( (height + cell_h - 1) / cell_h )) $out"
