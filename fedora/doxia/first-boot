#!/usr/bin/python3
"""DoxIA first login: the installer's last step, "Configurando o DoxIA".

The ISO installs from the packages of the day it was built and clones the repo
then; this screen brings the machine fully up to date before it is used. It is
the installer wizard again (same window, sidebar and progress strip, imported
from fedora/iso/wizard), asks for the user's password once, runs the Atualizar
menu's update (omarchy-update -y, which ends with fedora/update.sh) and lets the
Finalizar button through to the desktop.

install-user.sh leaves ~/.local/state/omarchy/doxia-first-boot-pending and starts
this from Hyprland's autostart; without that file it exits at once. A skipped or
failed update keeps the file, so the next login offers it again.

  DOXIA_DEMO=1 fedora/doxia/first-boot                     # try the screen; runs a fake update
  DOXIA_DEMO=1 DOXIA_DEMO_AUTO=1 fedora/doxia/first-boot   # ...and click through it alone
"""
import importlib.util
import os
import pty
import re
import subprocess
import sys
import threading
import time
from pathlib import Path

OMARCHY_PATH = Path(os.environ.get("OMARCHY_PATH", Path.home() / ".local/share/omarchy"))
PENDING = Path.home() / ".local/state/omarchy/doxia-first-boot-pending"
LOG = Path("/tmp/omarchy-update.log")
DEMO = bool(os.environ.get("DOXIA_DEMO"))

if not PENDING.exists() and not DEMO:
    sys.exit(0)

spec = importlib.util.spec_from_file_location(
    "doxia_installer", OMARCHY_PATH / "fedora/iso/wizard/doxia-installer.py")
wizard = importlib.util.module_from_spec(spec)
spec.loader.exec_module(wizard)

from gi.repository import Gdk, GLib, Gtk, Pango  # noqa: E402  (versions pinned by the wizard)

bevel_label = wizard.bevel_label
STEP_CONFIGURING = wizard.STEPS.index("Configurando o DoxIA")
SUDO_PROMPT = "[doxia-first-boot] senha: "
ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b[()][0-9A-Za-z]|\x1b[=>]")
DNF_ITEM = re.compile(r"\[\s*(\d+)/(\d+)\]\s+(.*?)(?:\s+\d+%.*)?$")

# omarchy-update's own headings, in order, with where each starts on the bar.
# fedora/update.sh (the post-update hook) fills 0.55-0.95 with its "==> " steps.
PHASES = [
    ("Update Omarchy dev checkout", 0.02, "Baixando a versão mais recente do DoxIA"),
    ("Update system packages", 0.06, "Atualizando os pacotes do sistema"),
    ("Running migration", 0.50, "Aplicando as migrações do DoxIA"),
    ("Update Flatpak apps", 0.95, "Atualizando os aplicativos Flatpak"),
    ("Update mise tools", 0.97, "Atualizando as ferramentas de desenvolvimento"),
    ("Restarting shell", 0.98, "Reiniciando a barra"),
]
HOOK_START, HOOK_END = 0.55, 0.95


def count_hook_steps():
    try:
        text = (OMARCHY_PATH / "fedora/update.sh").read_text()
    except OSError:
        return 30
    return max(1, len(re.findall(r'^echo "==> ', text, re.M)))


class FirstBoot(Gtk.Window):
    # The wizard's sidebar and step marks, borrowed as they are
    _sidebar = wizard.Wizard._sidebar
    set_step = wizard.Wizard.set_step
    page = wizard.Wizard.page
    _copy_panel = wizard.Wizard._copy_panel

    def __init__(self):
        super().__init__(title="Configuração do DoxIA")
        self.set_default_size(1024, 768)
        self.connect("delete-event", lambda *_: self.running)
        self.running = False
        self.password = None
        self.fraction = 0.0
        self.started_at = None
        self.reboot = False
        self.hook_steps = count_hook_steps()
        self.hook_seen = 0
        self.phase = None
        self.tail = []

        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        root.get_style_context().add_class("desktop")
        self.add(root)
        root.pack_start(self._sidebar(), False, False, 0)

        stage = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        stage.get_style_context().add_class("stage")
        root.pack_start(stage, True, True, 0)

        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        frame.get_style_context().add_class("win")
        frame.set_halign(Gtk.Align.CENTER)
        frame.set_valign(Gtk.Align.CENTER)
        frame.set_size_request(700, 460)
        frame.set_margin_start(28)
        frame.set_margin_end(28)
        stage.pack_start(frame, True, True, 0)
        self.frame = frame
        self.copy_panel = self._copy_panel()
        stage.pack_end(self.copy_panel, False, False, 0)

        bar = Gtk.Box(spacing=4)
        bar.get_style_context().add_class("titlebar98")
        bar.pack_start(Gtk.Label(label="Configuração do DoxIA", xalign=0), True, True, 0)
        frame.pack_start(bar, False, False, 0)
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        body.get_style_context().add_class("win-body")
        frame.pack_start(body, True, True, 0)

        self.stack = Gtk.Stack()
        body.pack_start(self.stack, True, True, 0)
        body.pack_start(Gtk.Separator(), False, False, 0)

        buttons = Gtk.Box(spacing=8)
        buttons.get_style_context().add_class("buttons")
        buttons.set_halign(Gtk.Align.END)
        self.skip = Gtk.Button.new_with_mnemonic("Agora _não")
        self.next = Gtk.Button.new_with_mnemonic("_Atualizar")
        self.next.get_style_context().add_class("default")
        self.next.set_can_default(True)
        for b in (self.skip, self.next):
            b.set_size_request(92, -1)
        buttons.pack_start(self.next, False, False, 0)
        buttons.pack_start(self.skip, False, False, 0)
        body.pack_start(buttons, False, False, 0)
        self.next.connect("clicked", self.on_next)
        self.skip.connect("clicked", self.on_skip)

        self.stack.add_named(self._page_password(), "password")
        self.stack.add_named(self.page("Atualizando o DoxIA...", None), "running")
        self.stack.add_named(self._page_done(), "done")
        self.stack.add_named(self._page_failed(), "failed")
        self.show_all()
        self.go("password")
        if DEMO and os.environ.get("DOXIA_DEMO_AUTO"):
            # Walks the screens on its own, for screenshots
            self.entry.set_text("demo")
            GLib.timeout_add(1500, lambda: self.next.clicked() and False)

    # Pages

    def _page_password(self):
        box = self.page(
            "Últimos ajustes",
            "O DoxIA foi instalado. Antes do primeiro uso, ele vai baixar e instalar as "
            "atualizações mais recentes do sistema e do próprio DoxIA. Isso leva alguns "
            "minutos e precisa de internet.")
        box.pack_start(bevel_label(
            "Digite a sua senha para autorizar a atualização. Ela é usada só pelo comando "
            "omarchy-update, que instala os pacotes como administrador (sudo).", "dim"),
            False, False, 0)
        row = Gtk.Box(spacing=10)
        row.set_margin_top(12)
        row.pack_start(bevel_label(f"Senha de {os.environ.get('USER', 'usuário')}:", wrap=False),
                       False, False, 0)
        self.entry = Gtk.Entry(visibility=False, activates_default=True)
        self.entry.set_width_chars(28)
        self.entry.connect("changed", lambda *_: self.pw_error.set_text(" "))
        self.entry.connect("activate", self.on_next)
        row.pack_start(self.entry, False, False, 0)
        box.pack_start(row, False, False, 0)
        self.pw_error = bevel_label(" ", "error")
        box.pack_start(self.pw_error, False, False, 0)
        return box

    def _page_done(self):
        box = self.page("O DoxIA está pronto", None)
        self.done_text = bevel_label("")
        box.pack_start(self.done_text, False, False, 0)
        return box

    def _page_failed(self):
        box = self.page("A atualização não pôde ser concluída", None)
        self.fail_text = bevel_label("")
        box.pack_start(self.fail_text, False, False, 0)
        self.fail_tail = bevel_label("", "dim")
        self.fail_tail.set_ellipsize(Pango.EllipsizeMode.START)
        box.pack_start(self.fail_tail, False, False, 0)
        box.pack_start(bevel_label(
            f"O registro completo está em {LOG}. Você pode tentar de novo agora ou ir para a "
            "área de trabalho: a atualização volta a ser oferecida no próximo login e também "
            "fica no menu (Super + Alt + Espaço, Atualizar).", "dim"), False, False, 0)
        return box

    def go(self, name):
        self.stack.set_visible_child_name(name)
        self.current = name
        self.frame.set_visible(name != "running")
        self.copy_panel.set_visible(name == "running")
        self.set_step(STEP_CONFIGURING + (1 if name == "done" else 0))
        self.skip.set_visible(name in ("password", "failed"))
        self.skip.set_label("Agora _não" if name == "password" else "Ir para a área de _trabalho")
        self.next.set_label({"password": "_Atualizar", "failed": "_Tentar novamente",
                             "done": "_Reiniciar" if self.reboot else "_Finalizar"}.get(name, ""))
        self.next.set_use_underline(True)
        self.next.set_sensitive(True)
        if name == "password":
            self.eta.set_text("5 a 15 minutos")
            GLib.idle_add(self.entry.grab_focus)
        self.set_default(self.next)

    # Actions

    def on_skip(self, _button):
        Gtk.main_quit()

    def on_next(self, _button):
        if self.current == "password":
            self.check_password()
        elif self.current == "failed":
            self.start()
        elif self.current == "done":
            PENDING.unlink(missing_ok=True)
            if self.reboot and not DEMO:
                subprocess.Popen(["omarchy-system-reboot"])
            Gtk.main_quit()

    def check_password(self):
        password = self.entry.get_text()
        if not password:
            self.pw_error.set_text("Digite a sua senha.")
            return
        self.next.set_sensitive(False)

        def worker():
            ok = DEMO or subprocess.run(
                ["sudo", "-S", "-k", "-v", "-p", ""], input=password + "\n", text=True,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
            GLib.idle_add(done, ok)

        def done(ok):
            self.next.set_sensitive(True)
            if not ok:
                self.pw_error.set_text("Senha incorreta. Tente de novo.")
                self.entry.set_text("")
                self.entry.grab_focus()
                return
            self.password = password
            self.entry.set_text("")
            self.start()

        threading.Thread(target=worker, daemon=True).start()

    # The update

    def start(self):
        self.running = True
        self.fraction = 0.0
        self.reboot = False
        self.hook_seen = 0
        self.phase = None
        self.tail = []
        self.started_at = time.time()
        self.bar.set_fraction(0)
        self.percent.set_text("0%")
        self.set_status("Preparando a atualização", " ")
        self.go("running")
        GLib.timeout_add_seconds(12, self.next_tip)
        GLib.timeout_add(500, self.tick)
        threading.Thread(target=self.run_update, daemon=True).start()

    def run_update(self):
        # In a pseudo-terminal so sudo asks there (and remembers the password for the
        # session) and dnf prints its per-package progress; the prompt is answered here.
        demo = ("echo 'Update Omarchy dev checkout'; sleep 0.5; echo 'Update system packages'; "
                "for i in $(seq 1 40); do echo \"[$i/40] Instalando demo-$i.rpm 100%\"; sleep 0.05; done; "
                "for s in 'Kitty as the default terminal' 'Branding' 'Theme (RHEL 8)'; do echo \"==> $s\"; sleep 0.6; done; "
                "echo 'Update Flatpak apps'; sleep 0.5")
        command = ["bash", "-c", demo] if DEMO else ["omarchy-update", "-y"]
        env = dict(os.environ, SUDO_PROMPT=SUDO_PROMPT, TERM="dumb", COLUMNS="200", NO_COLOR="1")
        pid, fd = pty.fork()
        if pid == 0:
            os.execvpe(command[0], command, env)
        pending = ""
        while True:
            try:
                data = os.read(fd, 4096)
            except OSError:
                break
            if not data:
                break
            pending += ANSI.sub("", data.decode(errors="replace"))
            if SUDO_PROMPT in pending:
                pending = pending.replace(SUDO_PROMPT, "")
                os.write(fd, (self.password or "").encode() + b"\n")
            *lines, pending = re.split(r"[\r\n]", pending)
            for line in lines:
                if line.strip():
                    GLib.idle_add(self.on_line, line.strip())
        _, status = os.waitpid(pid, 0)
        os.close(fd)
        GLib.idle_add(self.finished, os.waitstatus_to_exitcode(status))

    def on_line(self, line):
        self.tail = (self.tail + [line])[-6:]
        if line.startswith("Reboot required:"):
            self.reboot = True
        for heading, start, text in PHASES:
            if line.startswith(heading):
                self.phase = heading
                self.set_status(text, " ")
                self.set_progress(start)
                return
        if line.startswith("==> "):
            self.phase = "hook"
            self.hook_seen += 1
            share = min(self.hook_seen, self.hook_steps) / self.hook_steps
            self.set_status("Configurando o DoxIA", line[4:])
            self.set_progress(HOOK_START + (HOOK_END - HOOK_START) * share)
            return
        m = DNF_ITEM.match(line)
        if m and self.phase == "Update system packages":
            n, total = int(m.group(1)), int(m.group(2))
            self.set_status("Atualizando os pacotes do sistema", f"{m.group(3)} ({n} de {total})")
            self.set_progress(0.06 + 0.42 * n / max(1, total))
        elif self.phase != "hook":
            self.copy_detail.set_text(line)

    def set_status(self, status, detail):
        self.copy_status.set_text(status)
        self.copy_detail.set_text(detail or " ")

    def set_progress(self, fraction):
        self.fraction = max(self.fraction, min(fraction, 1.0))
        self.bar.set_fraction(self.fraction)
        self.percent.set_text(f"{int(self.fraction * 100)}%")

    def tick(self):
        if not self.running:
            return False
        elapsed = time.time() - self.started_at
        if self.fraction < 0.1 or elapsed < 30:
            self.eta.set_text("5 a 15 minutos")
        else:
            minutes = max(1, round(elapsed * (1 - self.fraction) / self.fraction / 60))
            self.eta.set_text("1 minuto" if minutes == 1 else f"{minutes} minutos")
        return True

    def next_tip(self):
        if not self.running:
            return False
        tips = wizard.TIPS
        self.tip.set_text(tips[(tips.index(self.tip.get_text()) + 1) % len(tips)])
        return True

    def finished(self, code):
        self.running = False
        if code == 0:
            self.password = None
            self.set_progress(1.0)
            self.eta.set_text("—")
            self.done_text.set_text(
                "As atualizações foram instaladas. "
                + ("Algumas só valem depois de reiniciar: clique em Reiniciar para começar a usar o DoxIA."
                   if self.reboot else "Clique em Finalizar para ir para a área de trabalho."))
            self.go("done")
        else:
            self.fail_text.set_text(
                "Algo deu errado durante a atualização. Confira se o computador está conectado "
                "à internet e tente de novo.")
            self.fail_tail.set_text("\n".join(self.tail[-3:]))
            self.eta.set_text("—")
            self.go("failed")


def main():
    settings = Gtk.Settings.get_default()
    settings.set_property("gtk-theme-name", "Adwaita")
    settings.set_property("gtk-application-prefer-dark-theme", False)
    settings.set_property("gtk-font-name", "Red Hat Text 10")
    provider = Gtk.CssProvider()
    provider.load_from_path(str(OMARCHY_PATH / "fedora/iso/wizard/doxia-installer.css"))
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    win = FirstBoot()
    win.connect("destroy", Gtk.main_quit)
    win.fullscreen()
    Gtk.main()


if __name__ == "__main__":
    main()
