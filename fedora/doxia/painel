def validate_actions(actions):
    """Descarta ações malformadas, devolvendo (válidas, avisos)."""
    required = {
        "jira-request": ("serviceDesk", "requestType", "fields"),
        "jira-tasks": (),
        "gitlab-pipeline": ("project",),
        "claude-text": (),
        "link": ("url",),
        "command": ("run",),
    }
    valid, warnings, seen = [], [], set()
    for a in actions:
        if not isinstance(a, dict):
            warnings.append("ação que não é um objeto")
            continue
        aid, kind = a.get("id"), a.get("type")
        if not aid or not a.get("title") or kind not in required:
            warnings.append(f"ação {aid or '?'}: precisa de id, title e um type conhecido")
            continue
        if aid in seen or aid == "home" or aid == "credenciais":
            warnings.append(f"ação {aid}: id repetido ou reservado")
            continue
        lacking = [k for k in required[kind] if not a.get(k)]
        if lacking:
            warnings.append(f"ação {aid}: faltando {', '.join(lacking)}")
            continue
        seen.add(aid)
        valid.append(a)
    return valid, warnings


class PainelWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Painel Rápido", default_width=560, default_height=640)
        self.toasts = Adw.ToastOverlay()
        self.nav = Adw.NavigationView()
        self.toasts.set_child(self.nav)
        self.set_content(self.toasts)
        self._after_credentials = None
        self.load()

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

    def load(self):
        self.cfg, error = load_config()
        self.actions, warnings = validate_actions(self.cfg["actions"])
        if warnings and not error:
            if self.actions:
                self.toasts.add_toast(Adw.Toast(title="Ignorado: " + "; ".join(warnings), timeout=8))
            else:
                error = "; ".join(warnings)
        self.by_id = {a["id"]: a for a in self.actions}
        self.nav.add(HomePage(self, self.actions, error))
        for action in self.actions:
            if action["type"] in PAGE_TYPES:
                self.nav.add(PAGE_TYPES[action["type"]](self, self.cfg, action))

    def reload(self):
        """Relê painel.json abrindo uma janela nova no lugar desta."""
        win = PainelWindow(self.get_application())
        win.present()
        win.toasts.add_toast(Adw.Toast(title="Configuração recarregada", timeout=2))
        self.destroy()

    def open_action(self, action_id, from_cli=False):
        action = self.by_id.get(action_id)
        if not action:
            self.toasts.add_toast(Adw.Toast(title=f"Ação “{action_id}” não existe em {CONFIG_FILE.name}"))
            return None
        if action["type"] in PAGE_TYPES:
            self.nav.replace_with_tags(["home", action_id])
            return "page"
        run_direct(action)
        if not from_cli:
            self.close()
        return "direct"

    def on_key(self, _ctrl, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            if self.nav.get_visible_page().get_tag() == "home":
                self.close()
            else:
                self.nav.pop()
            return True
        return False

    def push_credentials(self, site, then=None):
        if not site:
            self.toasts.add_toast(Adw.Toast(title=f"Falta o site do Jira em {CONFIG_FILE.name}"))
            return
        self._after_credentials = then

        def saved():
            self.nav.pop()
            cb, self._after_credentials = self._after_credentials, None
            if cb:
                GLib.idle_add(cb)

        self.nav.push(CredentialsPage(site, saved))

    def notify_link(self, title, url):
        self.get_clipboard().set(url)
        toast = Adw.Toast(title=f"{title} · link copiado", button_label="Abrir", timeout=8)
        toast.connect("button-clicked", lambda *_: open_url(url))
        self.toasts.add_toast(toast)
        GLib.spawn_async(["omarchy-notification-send", "--app-name", "Painel Rápido", title, url],
                         flags=GLib.SpawnFlags.SEARCH_PATH)


class PainelApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)

    def do_startup(self):
        Adw.Application.do_startup(self)
        css = Gtk.CssProvider()
        css.load_from_string("textview.painel-desc, textview.painel-desc > text { background: transparent; }")
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        win = self.props.active_window
        fresh = win is None
        if fresh:
            win = PainelWindow(self)
        target = args[0] if args else None
        if target == "--favorito":
            target = win.cfg.get("favorite")
        if target and win.open_action(target, from_cli=True) == "direct" and fresh:
            win.destroy()
            return 0
        win.present()
        return 0


