            title=f"Acesso ao {urllib.parse.urlparse(site).netloc or site}",
            description="Usado só para agir no Jira em seu nome. Fica salvo em "
                        f"{CREDENTIALS_FILE.as_posix().replace(str(Path.home()), '~')} (visível só para você).",
        )
