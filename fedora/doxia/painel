        add_shortcut(self, "<Control><Shift>c", lambda: self.on_copy(None))
        self.connect("shown", lambda *_: self.view.grab_focus())

    def text(self):
        buf = self.view.get_buffer()
        return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()

    def set_text(self, text):
        buf = self.view.get_buffer()
        buf.set_text(text)
        buf.place_cursor(buf.get_start_iter())

    def set_busy(self, busy):
        self.improve_btn.set_sensitive(not busy)
        self.copy_btn.set_sensitive(not busy)
        self.view.set_editable(not busy)
        self.spinner.set_visible(busy)

    def on_copy(self, _btn):
        text = self.text()
        if not text:
            self.status.set_text("Nada para copiar")
            return
        self.get_clipboard().set(text)
        self.window.toasts.add_toast(Adw.Toast(title="Texto copiado"))

    def on_improve(self, _btn):
        if not self.improve_btn.get_sensitive():
            return
        original = self.text()
        if not original:
            self.status.set_text("Cole um texto primeiro")
            self.view.grab_focus()
            return
        extra = self.instruction.get_text().strip() if self.instruction else ""
        context = [("Instrução extra", extra)] if extra else []
        self.set_busy(True)
        self.status.set_text("Claude escrevendo…")

        def done(text, err):
            self.set_busy(False)
            if err:
                self.status.set_text(str(err))
                return
            self.status.set_text("Revise o texto antes de usar.")
            self.set_text(text)
            toast = Adw.Toast(title="Texto reescrito pelo Claude", button_label="Desfazer", timeout=10)
            toast.connect("button-clicked", lambda *_: self.set_text(original))
            self.window.toasts.add_toast(toast)

        run_async(lambda: claude_rewrite(self.spec, context, original), done)


