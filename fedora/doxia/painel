def run_direct(action):
    """Ações sem página: link e command."""
    if action["type"] == "link":
        open_url(action["url"])
    else:
        cmd = action["run"]
        argv = ["bash", "-c", cmd] if isinstance(cmd, str) else [os.path.expanduser(a) for a in cmd]
        subprocess.Popen(argv, cwd=str(expand_path(action.get("dir", "~"))), start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


