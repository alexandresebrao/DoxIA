        creds = {"email": self.email.get_text().strip(), "token": self.token.get_text().strip()}
        if not creds["email"] or not creds["token"]:
            self.status.set_text("Preencha e-mail e token.")
            return
        self.save_btn.set_sensitive(False)
        self.status.set_text("Testando…")

        def done(user, err):
            self.save_btn.set_sensitive(True)
            if err:
                self.status.set_text(str(err))
                return
            save_credentials(self.site, creds)
            self.status.set_text(f"Conectado como {user.get('displayName', creds['email'])}.")
            self.on_saved()

        run_async(lambda: jira_request(self.site, creds, "GET", "/rest/api/3/myself"), done)


class JiraRequestPage(Adw.NavigationPage):
    """Formulário de chamado do Jira Service Management."""

    def __init__(self, window, cfg, action):
        super().__init__(title=action["title"], tag=action["id"])
        self.window = window
        self.action = action
        self.site = jira_site(cfg, action)
        self.fields = action.get("fields") or []
        self.claude = action.get("claude")
        self.inputs = {}

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        if action.get("portalUrl"):
            portal = Gtk.Button(icon_name="web-browser-symbolic", tooltip_text="Abrir no portal")
            portal.connect("clicked", lambda *_: open_url(action["portalUrl"]))
            header.pack_end(portal)
        toolbar.add_top_bar(header)

        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup(title=action.get("formTitle", action["title"]),
                                     description=action.get("formDescription", ""))
        page.add(group)
        for field in self.fields:
            if field.get("multiline"):
                text_group = Adw.PreferencesGroup(title=field["label"], description=field.get("hint", ""))
                view = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=10, bottom_margin=10,
                                    left_margin=12, right_margin=12, accepts_tab=False)
                view.add_css_class("painel-desc")
                text_group.add(Gtk.ScrolledWindow(min_content_height=180, css_classes=["card"], child=view))
                page.add(text_group)
                self.inputs[field["key"]] = view
            else:
                row = entry_row(field["label"], field.get("hint", ""))
                group.add(row)
                self.inputs[field["key"]] = row
        if all(f.get("multiline") for f in self.fields):
            group.set_visible(bool(group.get_description()))

        self.status = Gtk.Label(wrap=True, css_classes=["dim-label"], margin_top=6)
        self.send_btn = Gtk.Button(label=action.get("submitLabel", "Abrir chamado"),
                                   css_classes=["suggested-action", "pill"], halign=Gtk.Align.CENTER, margin_top=6)
        self.send_btn.connect("clicked", self.on_send)
        buttons = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER)
        self.claude_btn = None
        self.claude_spinner = Adw.Spinner(visible=False, margin_top=6)
        if self.claude and self.claude.get("field") in self.inputs:
            self.claude_btn = Gtk.Button(css_classes=["pill"], margin_top=6,
                                         tooltip_text=self.claude.get("tooltip", "Reescrever o texto com o Claude") + " (Ctrl+E)")
            self.claude_btn.set_child(Adw.ButtonContent(icon_name="document-edit-symbolic",
                                                        label=self.claude.get("label", "Melhorar com Claude")))
            self.claude_btn.connect("clicked", self.on_improve)
            buttons.append(self.claude_btn)
            add_shortcut(self, "<Control>e", lambda: self.on_improve(None))
        buttons.append(self.claude_spinner)
        buttons.append(self.send_btn)
        page.add(action_button_box(buttons, self.status))

        toolbar.set_content(page)
        self.set_child(toolbar)

        add_shortcut(self, "<Control>Return", lambda: self.on_send(None))
        first = next(iter(self.inputs.values()), None)
        if first:
            self.connect("shown", lambda *_: first.grab_focus())

    def value(self, key):
        widget = self.inputs[key]
        if isinstance(widget, Gtk.TextView):
            buf = widget.get_buffer()
            return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()
        return widget.get_text().strip()

    def set_value(self, key, text):
        widget = self.inputs[key]
        if isinstance(widget, Gtk.TextView):
            buf = widget.get_buffer()
            buf.set_text(text)
            buf.place_cursor(buf.get_start_iter())
        else:
            widget.set_text(text)

    def clear(self):
        for key in self.inputs:
            self.set_value(key, "")
        self.status.set_text("")

    def set_busy(self, busy):
        self.send_btn.set_sensitive(not busy)
        if self.claude_btn:
            self.claude_btn.set_sensitive(not busy)
        self.claude_spinner.set_visible(busy)
        target = self.inputs.get((self.claude or {}).get("field"))
        if isinstance(target, Gtk.TextView):
            target.set_editable(not busy)

    def on_improve(self, _btn):
        if not self.claude_btn or not self.claude_btn.get_sensitive():
            return
        key = self.claude["field"]
        original = self.value(key)
        if not original:
            label = next(f["label"] for f in self.fields if f["key"] == key)
            self.status.set_text(f"Escreva {label.lower()} primeiro")
            self.inputs[key].grab_focus()
            return
        context = [(f["label"], self.value(f["key"])) for f in self.fields if f["key"] != key]
        self.set_busy(True)
        self.status.set_text("Claude escrevendo…")

        def done(text, err):
            self.set_busy(False)
            if err:
                self.status.set_text(str(err))
                return
            self.status.set_text("Revise o texto antes de enviar.")
            self.set_value(key, text)
            toast = Adw.Toast(title="Texto reescrito pelo Claude", button_label="Desfazer", timeout=10)
            toast.connect("button-clicked", lambda *_: self.set_value(key, original))
            self.window.toasts.add_toast(toast)

        run_async(lambda: claude_rewrite(self.claude, context, original), done)

    def on_send(self, _btn):
        if not self.send_btn.get_sensitive():
            return
        values = {f["key"]: self.value(f["key"]) for f in self.fields}
        missing = [f["label"] for f in self.fields if f.get("required", True) and not values[f["key"]]]
        if missing:
            self.status.set_text("Faltando: " + ", ".join(missing))
            return
        creds = load_credentials(self.site)
        if not creds.get("token"):
            self.window.push_credentials(self.site, then=lambda: self.on_send(None))
            return

        self.send_btn.set_sensitive(False)
        self.status.set_text("Enviando…")

        def done(issue, err):
            self.send_btn.set_sensitive(True)
            if err:
                self.status.set_text(str(err))
                if "401" in str(err):
                    self.window.push_credentials(self.site, then=lambda: self.on_send(None))
                return
            key = issue.get("issueKey", "?")
            url = (issue.get("_links") or {}).get("web") or f"{self.site}/browse/{key}"
            self.clear()
            self.window.notify_link(f"Chamado {key} criado", url)

        values = {k: v for k, v in values.items() if v}
        run_async(lambda: create_jira_request(self.site, creds, self.action, values), done)


