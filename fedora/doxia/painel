        self.email.set_text(creds.get("email", ""))
        self.token = Adw.PasswordEntryRow(title="API token")
        self.token.set_text(creds.get("token", ""))
        group.add(self.email)
        group.add(self.token)

        link = Adw.ActionRow(title="Gerar um API token", subtitle="id.atlassian.com → Segurança → API tokens",
                             activatable=True)
        link.add_suffix(Gtk.Image.new_from_icon_name("external-link-symbolic"))
        link.connect("activated", lambda *_: open_url(TOKEN_URL))
        group.add(link)
        page.add(group)

        self.status = Gtk.Label(wrap=True, css_classes=["dim-label"], margin_top=6)
        self.save_btn = Gtk.Button(label="Testar e salvar", css_classes=["suggested-action", "pill"],
