        self.spinner = Adw.Spinner(visible=False, margin_top=6)
        self.improve_btn = Gtk.Button(css_classes=["suggested-action", "pill"], margin_top=6,
                                      tooltip_text="Reescrever o texto com o Claude (Ctrl+Enter)")
        self.improve_btn.set_child(Adw.ButtonContent(icon_name="document-edit-symbolic",
                                                     label=action.get("label", "Melhorar com Claude")))
        self.improve_btn.connect("clicked", self.on_improve)
        self.copy_btn = Gtk.Button(css_classes=["pill"], margin_top=6, tooltip_text="Copiar o texto (Ctrl+Shift+C)")
        self.copy_btn.set_child(Adw.ButtonContent(icon_name="edit-copy-symbolic", label="Copiar"))
        self.copy_btn.connect("clicked", self.on_copy)
        buttons = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER)
