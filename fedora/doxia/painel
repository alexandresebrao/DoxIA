        page.add(self.recent_group)

        self.status = Gtk.Label(wrap=True, css_classes=["dim-label"], margin_top=6)
        self.send_btn = Gtk.Button(label=action.get("submitLabel", "Iniciar pipeline"),
                                   css_classes=["suggested-action", "pill"], halign=Gtk.Align.CENTER, margin_top=6)
        self.send_btn.connect("clicked", self.on_send)
        page.add(action_button_box(self.send_btn, self.status))

        toolbar.set_content(page)
        self.set_child(toolbar)
        add_shortcut(self, "<Control>Return", lambda: self.on_send(None))

        self.fill((load_recent(action["id"], self.keys) or [default])[0])
        self.refresh_recent()
        self.connect("shown", lambda *_: self.load_branches())

    def selected_branch(self):
        item = self.branch.get_selected_item()
        return item.get_string() if item else ""

    def select_branch(self, ref):
        if not ref:
            return
        if ref not in self.branches:
            self.branches.append(ref)
            self.branch_model.append(ref)
        self.branch.set_selected(self.branches.index(ref))

    def fill(self, combo):
        self.select_branch(combo.get("ref", ""))
        for key, row in self.inputs.items():
            row.set_text(combo.get(key, ""))

    def load_branches(self):
        if len(self.branches) > 1:
            return
        current = self.selected_branch()

        def done(names, err):
            if err:
                self.status.set_text(f"Não deu para listar as branches: {err}")
                return
            self.branches = list(names)
            self.branch_model.splice(0, self.branch_model.get_n_items(), self.branches)
            self.select_branch(current or self.default["ref"])

        run_async(lambda: gitlab_branches(self.host, self.project), done)

    def refresh_recent(self):
        for row in self.recent_rows:
            self.recent_group.remove(row)
        self.recent_rows = []
        recent = load_recent(self.action["id"], self.keys)
        self.recent_group.set_visible(bool(recent))
        for combo in recent:
            subtitle = " · ".join(combo.get(v["key"], "") for v in self.variables if combo.get(v["key"]))
            row = Adw.ActionRow(title=GLib.markup_escape_text(combo["ref"]),
                                subtitle=GLib.markup_escape_text(subtitle), activatable=True)
            row.add_suffix(Gtk.Image.new_from_icon_name("edit-paste-symbolic"))
            row.connect("activated", lambda _r, c=combo: self.fill(c))
            self.recent_group.add(row)
            self.recent_rows.append(row)

    def on_send(self, _btn):
        if not self.send_btn.get_sensitive():
            return
        combo = {"ref": self.selected_branch()}
        combo.update({k: row.get_text().strip() for k, row in self.inputs.items()})
        labels = {"ref": "Branch", **{v["key"]: v.get("label", v["key"]) for v in self.variables}}
        missing = [labels[k] for k in self.keys if not combo[k]]
        if missing:
            self.status.set_text("Faltando: " + ", ".join(missing))
            return

        self.send_btn.set_sensitive(False)
        self.status.set_text("Iniciando…")
        variables = {k: v for k, v in combo.items() if k != "ref" and v}

        def done(pipeline, err):
            self.send_btn.set_sensitive(True)
            if err:
                self.status.set_text(str(err))
                return
            save_recent(self.action["id"], self.keys, combo)
            self.refresh_recent()
            self.status.set_text("")
            url = pipeline.get("web_url") or f"{self.web_url}/-/pipelines/{pipeline.get('id')}"
            self.window.notify_link(f"Pipeline #{pipeline.get('id', '?')} iniciada ({combo['ref']})", url)

        run_async(lambda: gitlab_pipeline(self.host, self.project, combo["ref"], variables), done)


class JiraTasksPage(Adw.NavigationPage):
    """Resultado de uma busca JQL agrupado por categoria e status."""

    def __init__(self, window, cfg, action):
        super().__init__(title=action["title"], tag=action["id"])
        self.window = window
        self.site = jira_site(cfg, action)
        self.jql = action.get("jql") or "assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC"
        self.issues = []
        self.groups = []

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.refresh_btn = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Atualizar (Ctrl+R)")
        self.refresh_btn.connect("clicked", lambda *_: self.load())
        header.pack_start(self.refresh_btn)
        web = Gtk.Button(icon_name="web-browser-symbolic", tooltip_text="Abrir a busca no Jira")
        web.connect("clicked", lambda *_: open_url(f"{self.site}/issues/?jql={urllib.parse.quote(self.jql)}"))
        header.pack_end(web)
        toolbar.add_top_bar(header)

        self.search = Gtk.SearchEntry(placeholder_text="Filtrar por chave, projeto ou título",
                                      margin_start=12, margin_end=12, margin_top=6, margin_bottom=6)
        self.search.connect("search-changed", lambda *_: self.render())
        toolbar.add_top_bar(self.search)

        self.page = Adw.PreferencesPage()
        self.status = Adw.StatusPage(icon_name="view-list-symbolic", title="Carregando…")
        self.stack = Gtk.Stack()
        self.stack.add_named(self.status, "status")
        self.stack.add_named(self.page, "list")
        toolbar.set_content(self.stack)
        self.set_child(toolbar)

        add_shortcut(self, "<Control>r", self.load)
        add_shortcut(self, "<Control>f", self.search.grab_focus)
        self.connect("shown", lambda *_: self.load())

    def load(self):
        if not self.refresh_btn.get_sensitive():
            return
        creds = load_credentials(self.site)
        if not creds.get("token"):
            self.window.push_credentials(self.site, then=self.load)
            return
        self.refresh_btn.set_sensitive(False)
        if not self.issues:
            self.status.set_title("Carregando…")
            self.status.set_description("")
            self.stack.set_visible_child_name("status")

        def done(issues, err):
            self.refresh_btn.set_sensitive(True)
            if err:
                if "401" in str(err):
                    self.window.push_credentials(self.site, then=self.load)
                self.status.set_title("Não foi possível buscar as tarefas")
                self.status.set_description(str(err))
                self.stack.set_visible_child_name("status")
                return
            self.issues = issues
            self.render()
            self.page.scroll_to_top()

        run_async(lambda: search_issues(self.site, creds, self.jql), done)

    def render(self):
        for group in self.groups:
            self.page.remove(group)
        self.groups = []

        query = self.search.get_text().strip().lower()
        issues = [i for i in self.issues
                  if not query or query in " ".join((i["key"], i["fields"]["project"]["name"],
                                                     i["fields"]["summary"])).lower()]
        if not issues:
            self.status.set_title("Nenhuma tarefa" if not query else "Nada encontrado")
            self.status.set_description("" if not query else f"Nenhuma tarefa com “{query}”")
            self.stack.set_visible_child_name("status")
            return

        for category, label, color in TASKS_CATEGORIES:
            in_cat = [i for i in issues if i["fields"]["status"]["statusCategory"]["key"] == category]
            if not in_cat:
                continue
            by_status = {}
            for issue in in_cat:
                by_status.setdefault(issue["fields"]["status"]["name"], []).append(issue)

            group = Adw.PreferencesGroup(title=f"{label}  ·  {len(in_cat)}")
            for name, items in by_status.items():
                status_row = Adw.ExpanderRow(title=name, subtitle=f"{len(items)} tarefa{'s' * (len(items) > 1)}",
                                             expanded=category != "done" or bool(query))
                status_row.add_prefix(Gtk.Label(label="●", css_classes=[color]))
                for issue in items:
                    status_row.add_row(self.issue_row(issue))
                group.add(status_row)
            self.page.add(group)
            self.groups.append(group)
        self.stack.set_visible_child_name("list")

    def issue_row(self, issue):
        f = issue["fields"]
        url = f"{self.site}/browse/{issue['key']}"
        meta = [f["project"]["name"], f["issuetype"]["name"]]
        if f.get("priority"):
            meta.append(f["priority"]["name"])
        meta.append(time_ago(f.get("updated", "")))
        row = Adw.ActionRow(title=GLib.markup_escape_text(f"{issue['key']}  {f['summary']}"),
                            subtitle=GLib.markup_escape_text("  ·  ".join(m for m in meta if m)),
                            activatable=True, title_lines=2, tooltip_text="Abrir no Jira")
        copy = Gtk.Button(icon_name="edit-copy-symbolic", tooltip_text="Copiar link",
                          valign=Gtk.Align.CENTER, css_classes=["flat"])
        copy.connect("clicked", lambda *_: (self.get_clipboard().set(url),
                                            self.window.toasts.add_toast(Adw.Toast(title=f"Link de {issue['key']} copiado"))))
        row.add_suffix(copy)
        row.connect("activated", lambda *_: open_url(url))
        return row


