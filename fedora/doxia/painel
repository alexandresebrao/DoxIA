# --- Configuração -----------------------------------------------------------

def load_config():
    """Lê painel.json. Devolve (config, erro); sem arquivo é config vazia sem erro."""
    try:
        cfg = json.loads(CONFIG_FILE.read_text())
    except FileNotFoundError:
        return {"actions": []}, None
    except (OSError, ValueError) as e:
        return {"actions": []}, f"{CONFIG_FILE}: {e}"
    if not isinstance(cfg, dict) or not isinstance(cfg.get("actions", []), list):
        return {"actions": []}, f"{CONFIG_FILE}: esperado um objeto com a lista \"actions\""
    cfg.setdefault("actions", [])
    return cfg, None


def jira_site(cfg, action):
    site = action.get("site") or (cfg.get("jira") or {}).get("site") or ""
    return site.rstrip("/")


def load_credentials(site):
    try:
        return json.loads(CREDENTIALS_FILE.read_text()).get(site, {})
    except (OSError, ValueError, AttributeError):
        return {}


def save_credentials(site, creds):
    try:
        data = json.loads(CREDENTIALS_FILE.read_text())
    except (OSError, ValueError):
        data = {}
    data[site] = creds
    CREDENTIALS_FILE.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(CREDENTIALS_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
    os.chmod(CREDENTIALS_FILE, 0o600)


def expand_path(path):
    return Path(os.path.expandvars(os.path.expanduser(path)))


# --- Jira -------------------------------------------------------------------

class JiraError(Exception):
    pass


def jira_request(site, creds, method, path, body=None):
    auth = base64.b64encode(f"{creds['email']}:{creds['token']}".encode()).decode()
    req = urllib.request.Request(
        site + path,
        method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={
            "Authorization": f"Basic {auth}",
            "Accept": "application/json",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as e:
        raw = e.read().decode(errors="replace")
        try:
            data = json.loads(raw)
            msg = data.get("errorMessage") or "; ".join(data.get("errorMessages", [])) or raw
            if data.get("errors"):
                msg += " " + "; ".join(f"{k}: {v}" for k, v in data["errors"].items())
        except ValueError:
            msg = raw[:300]
        if e.code == 401:
            msg = "E-mail ou API token inválidos."
        raise JiraError(f"HTTP {e.code}: {msg}") from None
    except urllib.error.URLError as e:
        raise JiraError(f"Falha de conexão: {e.reason}") from None


def create_jira_request(site, creds, action, values):
    return jira_request(site, creds, "POST", "/rest/servicedeskapi/request", {
        "serviceDeskId": str(action["serviceDesk"]),
        "requestTypeId": str(action["requestType"]),
        "requestFieldValues": values,
    })


def search_issues(site, creds, jql):
    issues, token = [], None
    while True:
        body = {"jql": jql, "maxResults": 100,
                "fields": ["summary", "status", "priority", "project", "issuetype", "updated"]}
        if token:
            body["nextPageToken"] = token
        page = jira_request(site, creds, "POST", "/rest/api/3/search/jql", body)
        issues += page.get("issues", [])
        token = page.get("nextPageToken")
        if page.get("isLast", True) or not token:
            return issues


# --- GitLab -----------------------------------------------------------------

class GitlabError(Exception):
    pass


def gitlab_token(host):
    try:
        out = subprocess.run(["glab", "config", "get", "token", "--host", host],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        out = None
    token = out.stdout.strip() if out else ""
    if not token:
        raise GitlabError(f"Sem token do GitLab para {host}. Rode `glab auth login` no terminal.")
    return token


def gitlab_request(host, method, path, body=None):
    req = urllib.request.Request(
        f"https://{host}/api/v4{path}",
        method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={"PRIVATE-TOKEN": gitlab_token(host), "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as e:
        raw = e.read().decode(errors="replace")
        try:
            data = json.loads(raw)
            msg = data.get("message") or data.get("error") or raw
            if isinstance(msg, dict):
                msg = "; ".join(f"{k}: {', '.join(v) if isinstance(v, list) else v}" for k, v in msg.items())
            elif isinstance(msg, list):
                msg = "; ".join(map(str, msg))
        except ValueError:
            msg = raw[:300]
        if e.code == 401:
            msg = "token do glab inválido ou expirado (rode `glab auth login`)."
        raise GitlabError(f"HTTP {e.code}: {msg}") from None
    except urllib.error.URLError as e:
        raise GitlabError(f"Falha de conexão: {e.reason}") from None


def gitlab_project_path(project):
    return urllib.parse.quote(str(project), safe="")


def gitlab_branches(host, project):
    branches = gitlab_request(host, "GET",
                              f"/projects/{gitlab_project_path(project)}/repository/branches?per_page=100")
    return sorted(b["name"] for b in branches)


def gitlab_pipeline(host, project, ref, variables):
    return gitlab_request(host, "POST", f"/projects/{gitlab_project_path(project)}/pipeline", {
        "ref": ref,
        "variables": [{"key": k, "value": v} for k, v in variables.items()],
    })


def recent_file(action_id):
    return STATE_DIR / f"{action_id}.json"


def load_recent(action_id, keys):
    try:
        recent = json.loads(recent_file(action_id).read_text()).get("recent", [])
        return [r for r in recent if all(r.get(k) for k in keys)]
    except (OSError, ValueError, AttributeError):
        return []


def save_recent(action_id, keys, combo):
    recent = [combo] + [r for r in load_recent(action_id, keys) if r != combo]
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    recent_file(action_id).write_text(json.dumps({"recent": recent[:MAX_RECENT]}, indent=2))


# --- Claude -----------------------------------------------------------------

def claude_prompt(spec):
    if spec.get("promptFile"):
        return expand_path(spec["promptFile"]).read_text()
    return spec.get("prompt", "")


def claude_rewrite(spec, context, text):
    """Pede ao Claude Code (modo -p, sem ferramentas) uma nova versão do texto."""
    prompt = "".join(f"{label}: {value or '(não informado)'}\n" for label, value in context)
    prompt += f"\nTexto escrito por quem está preenchendo:\n{text}"
    try:
        system = claude_prompt(spec)
    except OSError as e:
        raise RuntimeError(f"Prompt do Claude: {e}") from None
    try:
        proc = subprocess.run(
            ["claude", "-p", "--model", spec.get("model", CLAUDE_MODEL), "--system-prompt", system,
             "--tools", "", "--strict-mcp-config", "--setting-sources", "",
             "--no-session-persistence"],
            input=prompt, capture_output=True, text=True, timeout=CLAUDE_TIMEOUT,
            cwd=GLib.get_tmp_dir())
    except FileNotFoundError:
        raise RuntimeError("Comando claude não encontrado no PATH") from None
    except subprocess.TimeoutExpired:
        raise RuntimeError("O Claude demorou demais para responder") from None
    out = proc.stdout.strip()
    if proc.returncode != 0 or not out:
        err = (proc.stderr or proc.stdout).strip().splitlines()
        raise RuntimeError("Claude: " + (err[-1] if err else f"saiu com código {proc.returncode}"))
    return out


# --- Utilidades da interface --------------------------------------------------

def run_async(func, on_done):
    """Roda func() numa thread e entrega (resultado, erro) no loop do GTK."""
    def worker():
        try:
            result, err = func(), None
        except Exception as e:  # noqa: BLE001
            result, err = None, e
        GLib.idle_add(on_done, result, err)
    threading.Thread(target=worker, daemon=True).start()


def open_url(url):
    Gio.AppInfo.launch_default_for_uri(url, None)


def time_ago(iso):
    """'2026-10-05T11:02:33.000-0300' -> 'há 3 h'."""
    from datetime import datetime, timezone
    try:
        then = datetime.strptime(iso[:19] + iso[-5:], "%Y-%m-%dT%H:%M:%S%z")
    except ValueError:
        return ""
    mins = int((datetime.now(timezone.utc) - then).total_seconds() // 60)
    if mins < 60:
        return f"há {max(mins, 1)} min"
    if mins < 24 * 60:
        return f"há {mins // 60} h"
    days = mins // (24 * 60)
    return "ontem" if days == 1 else f"há {days} dias"


def entry_row(title, placeholder=""):
    row = Adw.EntryRow(title=title)
    if placeholder:
        row.set_tooltip_text(placeholder)
    return row


def action_button_box(*widgets):
    group = Adw.PreferencesGroup()
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    for w in widgets:
        box.append(w)
    group.add(box)
    return group


def add_shortcut(widget, trigger, callback):
    keys = Gtk.ShortcutController(scope=Gtk.ShortcutScope.MANAGED)
    keys.add_shortcut(Gtk.Shortcut(trigger=Gtk.ShortcutTrigger.parse_string(trigger),
                                   action=Gtk.CallbackAction.new(lambda *_: callback() or True)))
    widget.add_controller(keys)


