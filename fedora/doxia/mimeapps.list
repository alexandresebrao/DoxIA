# DoxIA: aplicativos padrão do sistema (todos os usuários); instalado em /etc/xdg/mimeapps.list.
# Cada usuário pode trocar em ~/.config/mimeapps.list, que tem prioridade.
[Default Applications]
x-scheme-handler/mailto=org.gnome.Evolution.desktop
x-scheme-handler/mid=org.gnome.Evolution.desktop
message/rfc822=org.gnome.Evolution.desktop
application/x-extension-eml=org.gnome.Evolution.desktop
