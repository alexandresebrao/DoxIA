#!/bin/bash

# The DoxIA build of gpu-screen-recorder (as root), for install-system.sh and
# update.sh: the screen recording (omarchy-capture-screenrecording).
#
# Neither Fedora nor RPM Fusion packages it, and upstream (git.dec05eba.com)
# only publishes source snapshots; it came from the
# brycensranch/gpu-screen-recorder-git COPR, which DoxIA no longer enables. The
# DoxIA build is published as a release asset of this repository. Its %post
# gives gsr-kms-server cap_sys_admin, so recording a monitor over KMS asks for
# no password.
#
# To ship a new build: upload the RPM as release gpu-screen-recorder-<version>,
# then bump version below.

set -euo pipefail

version=6.1.5-1.doxia1
target="$version.fc$(rpm -E %fedora)"
rpm_file="gpu-screen-recorder-$target.$(uname -m).rpm"
url="https://github.com/alexandresebrao/DoxIA/releases/download/gpu-screen-recorder-$version/$rpm_file"

# Same epoch (2) as the COPR's builds, so versions compare without it.
installed=$(rpm -q --qf '%{VERSION}-%{RELEASE}' gpu-screen-recorder 2>/dev/null || true)
if [[ -z $installed ]]; then
  order=-1
else
  order=$(rpm --eval "%{lua:print(rpm.vercmp('$installed', '$target'))}")
fi

if (( order == 0 )); then
  exit 0
fi

# Published for one Fedora release and architecture at a time.
if ! curl -sfIL "$url" >/dev/null; then
  echo "No DoxIA gpu-screen-recorder build for this system: $url" >&2
  exit 1
fi

if (( order > 0 )); then
  dnf downgrade -y "$url"
else
  dnf install -y --setopt=install_weak_deps=False "$url"
fi
