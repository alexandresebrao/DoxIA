#!/bin/bash

# Puts the DoxIA bar in place for the current user: copies the plugins in
# fedora/doxia/plugins to ~/.config/omarchy/plugins (replacing older copies) and
# adds their widgets to ~/.config/omarchy/shell.json where they are missing:
# the ∞ menu button and workspace icons on the left, Now Playing centered with
# the screen share indicator after it, CPU/memory/battery usage on the right and
# the services panel (doxia.services) and FortiVPN (doxia.fortivpn) between the
# agents and network icons (the Omarchy indicators group is removed), and enables
# the Start menu (doxia.iniciar, opened by the ∞ button and SUPER+ALT+SPACE).
# A clock still in the center moves to the right corner showing date and time,
# and the Painel Rápido button (doxia.painel) leaves the bar: the Painel Rápido
# app (fedora/doxia/painel) goes on the PATH as doxia-painel, in the launcher and
# on SUPER+ALT+P.
# The panel's svc script goes on the PATH and its /servicos Claude Code skill to
# ~/.claude/skills.
# The bar floats (bar.floating) unless shell.json says otherwise.
# Widgets already placed (or moved) stay where they are, and the old Xi widgets
# become their DoxIA versions, as do the old alexandre.* plugins (their copies are
# removed). Run by install-user.sh and fedora/update.sh.

set -euo pipefail

omarchy_path=$(dirname "$(dirname "$(dirname "$(readlink -f "$0")")")")
plugins=$HOME/.config/omarchy/plugins
shell_json=$HOME/.config/omarchy/shell.json

mkdir -p "$plugins"
for name in alexandre.media alexandre.screenshare alexandre.services alexandre.fortivpn alexandre.painel; do
  rm -rf "${plugins:?}/$name"
done
for plugin in "$omarchy_path"/fedora/doxia/plugins/*/; do
  name=$(basename "$plugin")
  rm -rf "${plugins:?}/$name"
  cp -a "$plugin" "$plugins/$name"
done

mkdir -p "$HOME/.local/bin"
ln -sfn "$plugins/doxia.services/svc" "$HOME/.local/bin/svc"
ln -sfn "$omarchy_path/fedora/doxia/painel" "$HOME/.local/bin/doxia-painel"
mkdir -p "$HOME/.local/share/applications"
cat > "$HOME/.local/share/applications/org.doxia.Painel.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Painel Rápido
Comment=Atalhos do dia a dia: chamados, pipelines e tarefas
Keywords=painel;atalhos;jira;chamado;gitlab;pipeline;tarefas;
Exec=$omarchy_path/fedora/doxia/painel
Icon=utilities-terminal
Terminal=false
Categories=Utility;
StartupWMClass=org.doxia.Painel
DESKTOP
skills=$HOME/.claude/skills
mkdir -p "$skills"
for skill in "$omarchy_path"/fedora/doxia/claude/skills/*/; do
  name=$(basename "$skill")
  rm -rf "${skills:?}/$name"
  cp -a "$skill" "$skills/$name"
done

if [[ ! -f $shell_json ]]; then
  echo "  $shell_json not found; the bar layout was left alone" >&2
  exit 0
fi

jq '
  def has($id): any(.[]; .id == $id);
  # Inserts {id} right after Now Playing, or at the end without it.
  def after_media($id):
    if has($id) then . else
      (map(.id) | index("doxia.media")) as $i
      | if $i == null then . + [{id: $id}]
        else .[:$i + 1] + [{id: $id}] + .[$i + 1:] end
    end;
  def renamed:
    map(if .id == "omarchy.menu" or .id == "xi.emblem" then {id: "doxia.emblem"}
        elif .id == "omarchy.workspaces" or .id == "xi.workspaces" then {id: "doxia.workspaces"}
        elif .id == "xi.reactor" then {id: "doxia.usage"}
        elif .id | IN("alexandre.media", "alexandre.screenshare", "alexandre.services", "alexandre.fortivpn", "alexandre.painel")
          then .id |= sub("^alexandre"; "doxia")
        else . end);
  # Now Playing is the center anchor; the clock (when it is still in the center,
  # where Omarchy puts it) goes to the right corner showing only date and time.
  (.bar.layout.center // [] | map(select(.id == "omarchy.clock")) | first // null) as $clock
  | if .bar.centerAnchor == null or .bar.centerAnchor == "omarchy.clock" then .bar.centerAnchor = "doxia.media" else . end
  | if .bar.floating == null then .bar.floating = true else . end
  | .bar.layout |= (
    (.left, .center, .right) |= renamed
    # No indicators group (dictation, recording, night light, DND, stay awake):
    # DoxIA does not use them.
    | (.left, .center, .right) |= map(select(.id != "omarchy.indicators"))
    | if $clock == null then . else
        .center |= map(select(.id != "omarchy.clock"))
        | .right += [$clock | if (.format // "dddd HH:mm") == "dddd HH:mm" then .format = "dd/MM HH:mm" else . end]
      end
    | if (.left + .center + .right | has("doxia.media")) then . else .center |= [{id: "doxia.media"}] + . end
    | .center |= after_media("doxia.screenshare")
    | if (.left + .center + .right | has("doxia.usage")) then .
      else .right |= [{id: "doxia.usage"}] + . end
    # Services right after the agents icon (before the network group without it).
    | if (.left + .center + .right | has("doxia.services")) then .
      else .right |= (
        (map(.id) | index("omarchy.agents")) as $a
        | (map(.id == "omarchy.network" or (.members // [] | index("omarchy.network") != null)) | index(true)) as $n
        | if $a != null then .[:$a + 1] + [{id: "doxia.services"}] + .[$a + 1:]
          elif $n != null then .[:$n] + [{id: "doxia.services"}] + .[$n:]
          else . + [{id: "doxia.services"}] end)
      end
    | (.left, .center, .right) |= map(select(.id != "doxia.painel"))
    # FortiVPN right after the services panel.
    | if (.left + .center + .right | has("doxia.fortivpn")) then .
      else .right |= (
        (map(.id) | index("doxia.services")) as $s
        | if $s != null then .[:$s + 1] + [{id: "doxia.fortivpn"}] + .[$s + 1:]
          else . + [{id: "doxia.fortivpn"}] end)
      end
  )
  # The Start menu (doxia.iniciar) is a menu, not a bar widget: listing it under
  # plugins is what enables it.
  | .plugins = ((.plugins // []) | if any(.[]; .id == "doxia.iniciar") then . else . + [{id: "doxia.iniciar"}] end)
' "$shell_json" > "$shell_json.tmp"
mv "$shell_json.tmp" "$shell_json"

# doxia-shell (fedora/doxia/rs/shell) takes over Quickshell's notification
# service and polkit agent, from 0.5.0 its lock screen, from 0.7.0 its
# clipboard watchers and from 0.9.0 the idle timers (two would launch the
# screensaver and lock twice). With it installed, keep them off in shell.json, so
# Quickshell never starts them: once started, its notification server keeps
# the bus name until Quickshell restarts and drops what it gets while its
# plugin is unloaded, and two clipboard watchers would record every copy
# twice. Without doxia-shell, turn them back on, or nothing would show
# notifications, ask for passwords, lock the screen or keep the clipboard
# history. What the installed binary can do decides, not its presence: an
# older build would leave the rest unanswered. `doxia-shell --features`
# lists it (0.7.0 on); before that, the lock's PAM child (--pam) answers 2
# for an empty service without touching PAM, and older builds reject it.
taken=()
features=""
if command -v doxia-shell >/dev/null; then
  taken=(omarchy.notifications omarchy.polkit)
  features=$(doxia-shell --features 2>/dev/null) || features=""
  if [[ -z $features ]]; then
    pam=0
    doxia-shell --pam "" </dev/null &>/dev/null || pam=$?
    (( pam == 2 )) && features="lock"
  fi
  for feature in lock clipboard battery background idle; do
    if [[ " $features " == *" $feature "* ]]; then
      taken+=("omarchy.$feature")
    fi
  done
fi
jq '["omarchy.notifications", "omarchy.polkit", "omarchy.lock", "omarchy.clipboard", "omarchy.battery", "omarchy.background", "omarchy.idle"] as $all
    | ((.disabledPlugins // []) | map(select(. as $id | $all | index($id) | not)) + $ARGS.positional) as $off
    | if $off == [] then del(.disabledPlugins) else .disabledPlugins = $off end' \
  "$shell_json" --args "${taken[@]}" > "$shell_json.tmp"
mv "$shell_json.tmp" "$shell_json"

# From 0.8.0 doxia-shell draws the bar. Quickshell always loads one, so
# bar.id picks the doxia.bar plugin, which draws nothing, in its place; with
# an older doxia-shell (or none) Quickshell's own comes back.
if [[ " $features " == *" bar "* ]]; then
  jq 'if (.bar | type) == "object" then .bar.id = "doxia.bar" else . end' "$shell_json" > "$shell_json.tmp"
else
  jq 'if .bar.id? == "doxia.bar" then del(.bar.id) else . end' "$shell_json" > "$shell_json.tmp"
fi
mv "$shell_json.tmp" "$shell_json"
