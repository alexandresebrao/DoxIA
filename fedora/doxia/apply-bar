#!/bin/bash

# Puts the DoxIA bar in place for the current user: copies the plugins in
# fedora/doxia/plugins to ~/.config/omarchy/plugins (replacing older copies) and
# adds their widgets to ~/.config/omarchy/shell.json where they are missing:
# the ∞ menu button and workspace icons on the left, Now Playing and the screen
# share indicator around the clock, CPU/memory/battery usage on the right and
# the services panel (doxia.services) and FortiVPN (doxia.fortivpn) between the
# agents and network icons, and the Painel Rápido button (doxia.painel) at the
# end of the left side, and enables the Start menu (doxia.iniciar, opened by the
# ∞ button and SUPER+ALT+SPACE). The Painel Rápido app (fedora/doxia/painel) goes on the
# PATH as doxia-painel and in the launcher.
# The panel's svc script goes on the PATH and its /servicos Claude Code skill to
# ~/.claude/skills.
# Widgets already placed (or moved) stay where they are, and the old Xi widgets
# become their DoxIA versions, as do the old alexandre.* plugins (their copies are
# removed). Run by install-user.sh and fedora/update.sh.

set -euo pipefail

omarchy_path=$(dirname "$(dirname "$(dirname "$(readlink -f "$0")")")")
plugins=$HOME/.config/omarchy/plugins
shell_json=$HOME/.config/omarchy/shell.json

mkdir -p "$plugins"
for name in alexandre.media alexandre.screenshare alexandre.services alexandre.fortivpn alexandre.painel; do
  rm -rf "${plugins:?}/$name"
done
for plugin in "$omarchy_path"/fedora/doxia/plugins/*/; do
  name=$(basename "$plugin")
  rm -rf "${plugins:?}/$name"
  cp -a "$plugin" "$plugins/$name"
done

mkdir -p "$HOME/.local/bin"
ln -sfn "$plugins/doxia.services/svc" "$HOME/.local/bin/svc"
ln -sfn "$omarchy_path/fedora/doxia/painel" "$HOME/.local/bin/doxia-painel"
mkdir -p "$HOME/.local/share/applications"
cat > "$HOME/.local/share/applications/org.doxia.Painel.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Painel Rápido
Comment=Atalhos do dia a dia: chamados, pipelines e tarefas
Keywords=painel;atalhos;jira;chamado;gitlab;pipeline;tarefas;
Exec=$omarchy_path/fedora/doxia/painel
Icon=utilities-terminal
Terminal=false
Categories=Utility;
StartupWMClass=org.doxia.Painel
DESKTOP
skills=$HOME/.claude/skills
mkdir -p "$skills"
for skill in "$omarchy_path"/fedora/doxia/claude/skills/*/; do
  name=$(basename "$skill")
  rm -rf "${skills:?}/$name"
  cp -a "$skill" "$skills/$name"
done

if [[ ! -f $shell_json ]]; then
  echo "  $shell_json not found; the bar layout was left alone" >&2
  exit 0
fi

jq '
  def has($id): any(.[]; .id == $id);
  # Inserts {id} next to the clock (offset 0 = before it, 1 = after it), or at
  # the end when the clock is elsewhere.
  def by_clock($id; $offset):
    if has($id) then . else
      (map(.id) | index("omarchy.clock")) as $i
      | if $i == null then . + [{id: $id}]
        else .[:$i + $offset] + [{id: $id}] + .[$i + $offset:] end
    end;
  def renamed:
    map(if .id == "omarchy.menu" or .id == "xi.emblem" then {id: "doxia.emblem"}
        elif .id == "omarchy.workspaces" or .id == "xi.workspaces" then {id: "doxia.workspaces"}
        elif .id == "xi.reactor" then {id: "doxia.usage"}
        elif .id | IN("alexandre.media", "alexandre.screenshare", "alexandre.services", "alexandre.fortivpn", "alexandre.painel")
          then .id |= sub("^alexandre"; "doxia")
        else . end);
  .bar.layout |= (
    (.left, .center, .right) |= renamed
    | .center |= (by_clock("doxia.media"; 0) | by_clock("doxia.screenshare"; 1))
    | if (.left + .center + .right | has("doxia.usage")) then .
      else .right |= [{id: "doxia.usage"}] + . end
    # Services right after the agents icon (before the network group without it).
    | if (.left + .center + .right | has("doxia.services")) then .
      else .right |= (
        (map(.id) | index("omarchy.agents")) as $a
        | (map(.id == "omarchy.network" or (.members // [] | index("omarchy.network") != null)) | index(true)) as $n
        | if $a != null then .[:$a + 1] + [{id: "doxia.services"}] + .[$a + 1:]
          elif $n != null then .[:$n] + [{id: "doxia.services"}] + .[$n:]
          else . + [{id: "doxia.services"}] end)
      end
    | if (.left + .center + .right | has("doxia.painel")) then .
      else .left += [{id: "doxia.painel"}] end
    # FortiVPN right after the services panel.
    | if (.left + .center + .right | has("doxia.fortivpn")) then .
      else .right |= (
        (map(.id) | index("doxia.services")) as $s
        | if $s != null then .[:$s + 1] + [{id: "doxia.fortivpn"}] + .[$s + 1:]
          else . + [{id: "doxia.fortivpn"}] end)
      end
  )
  # The Start menu (doxia.iniciar) is a menu, not a bar widget: listing it under
  # plugins is what enables it.
  | .plugins = ((.plugins // []) | if any(.[]; .id == "doxia.iniciar") then . else . + [{id: "doxia.iniciar"}] end)
' "$shell_json" > "$shell_json.tmp"
mv "$shell_json.tmp" "$shell_json"
