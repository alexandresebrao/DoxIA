#!/bin/bash

# The Atualizar DoxIA window (fedora/doxia/atualizar), as root, for
# install-system.sh and update.sh. It is its own GTK app, not a shell panel, so
# it stays open while the update reloads or restarts the shell. The binary is a
# release asset of this repository, checked against the sha256 below; see
# fedora/doxia/atualizar/README.md to ship a new one.
#
# Without it (no network on install, say) omarchy-launch-update falls back to
# the shell panel (shell/plugins/update).

set -euo pipefail

version=0.1.0
sha256=3431b9ff41dd9c351110b615f1a50bdff5495b00247661e24460ee9437536e61
asset="doxia-atualizar-$(uname -m)"
url="https://github.com/alexandresebrao/DoxIA/releases/download/doxia-atualizar-$version/$asset"
target=/usr/local/bin/doxia-atualizar

if [[ -f $target ]] && [[ $(sha256sum "$target" | cut -d' ' -f1) == "$sha256" ]]; then
  exit 0
fi

rpm -q gtk4 &>/dev/null || dnf install -y gtk4

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
if ! curl -sfL --retry 3 -o "$tmp" "$url"; then
  echo "Could not download the Atualizar DoxIA window: $url" >&2
  exit 1
fi
if [[ $(sha256sum "$tmp" | cut -d' ' -f1) != "$sha256" ]]; then
  echo "Atualizar DoxIA: checksum mismatch for $url" >&2
  exit 1
fi
install -Dm755 "$tmp" "$target"
restorecon "$target" 2>/dev/null || true
