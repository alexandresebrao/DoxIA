{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/omarchy/branding/about.txt",
    "color": {
      "1": "default",
      "2": "#ee0000"
    },
    "padding": {
      "top": 12,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true,
    "percent": {
      "color": { "green": "default", "yellow": "#f0ab00", "red": "#ee0000" }
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "default"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "default"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "format": "{name}",
      "keyColor": "default"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "default"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "default"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "default"
    },
    {
      "type": "swap",
      "key": "└ └󰓡 ",
      "keyColor": "default"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": "\ue900 OS",
      "keyColor": "#ee0000",
      "text": "version=$(omarchy-version) && echo \"DoxIA $version\""
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "#ee0000",
      "text": "omarchy-version-branch"
    },
    {
      "type": "command",
      "key": "│ ├󰔫",
      "keyColor": "#ee0000",
      "text": "echo \"Fedora $(rpm -E %fedora)\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "#ee0000"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "#ee0000"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "#ee0000"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "#ee0000"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "#ee0000"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "#ee0000"
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "#ee0000",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "#ee0000"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "default",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "default"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "default",
      "text": "date -d @$(stat -c %Y /usr/lib/sysimage/rpm/rpmdb.sqlite) '+%A, %B %d %Y at %H:%M'"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
